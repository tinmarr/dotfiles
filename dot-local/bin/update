#!/usr/bin/env bash

set -e

cd ~/dotfiles
git pull
./install/restowall
cd ~

sudo -v
mirrors
paru -Syy
paru -Qu > $HOME/.cache/updated-packages.txt
echo "Starting update:"
metapac update-all
paru -Syu --removemake
paru -c --noconfirm

ZINIT="$HOME/.local/share/zinit/zinit.git/zinit.zsh"
if [[ $(command -v zsh) && -e $ZINIT ]]; then
    zsh -c "
        source "$ZINIT" && \
        zinit self-update && \
        zinit update --parallel
    "
fi

echo "---"
echo "$(cat $HOME/.cache/updated-packages.txt | wc -l) packages updated"
echo "Updated packages stored in ~/.cache/updated-packages.txt"

